# FinStack's URL (without /v1). https in production.
FINSTACK_API_URL=http://localhost:3000

# Encrypts the session cookie: 32 random bytes, base64. Generate with:
#   openssl rand -base64 32
# Changing it signs everyone out.
SESSION_SECRET=

# People are signed out after this many hours, whatever their activity (max 24).
# SESSION_MAX_AGE_HOURS=8

# The AI agent (the Ask tab). Leave unset to run without it.
# Claude: https://console.anthropic.com → API Keys
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# The agent's own FinStack API key, for one organization. Create it in FinStack
# with scopes: proposals:create, wallets:read, transactions:read, organization:read
# (NOT payouts:create). The agent can then propose payouts but never send them.
# AGENT_API_KEY=
# AGENT_ORGANIZATION_ID=
